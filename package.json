{
  "name": "flight-focus",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Local-first, privacy-respecting desktop focus timer with a flight metaphor.",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:integrity": "node scripts/check-source-integrity.mjs",
    "verify": "npm run check:integrity && npm run typecheck && npm run lint && npm run test && npm run build",
    "prepare": "node scripts/install-hooks.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^7.0.4",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "esbuild": true
  }
}
