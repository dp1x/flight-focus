# Normalize everything to LF in the repository, regardless of platform.
* text=auto eol=lf

# Windows-only scripts must keep CRLF so cmd.exe and PowerShell parse them.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Source that must never be normalized away.
*.rs   text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.css  text eol=lf
*.md   text eol=lf

# Binary assets: never diff, never normalize.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.icns binary
*.opus binary
*.woff binary
*.woff2 binary
